# FlyRank AI Capstone — Production Environment Variables Reference Template
# Copy this file to .env locally or configure secrets in Netlify / Vercel / GitHub Actions.

# Application Information
VITE_APP_TITLE="Srikant — FlyRank AI Capstone Portfolio"
VITE_APP_VERSION="1.0.0"
VITE_APP_ENV="production"

# Production Canonical URL
VITE_CANONICAL_URL="https://srikant-90.github.io/flyrank-ai-capstone/"

# External API Integrations (Rate-Limited Client-Side Calls)
VITE_ARXIV_API_BASE_URL="https://export.arxiv.org/api/query"

# Production Hardening & Anti-Abuse Controls
VITE_RATE_LIMIT_MAX_REQUESTS=10
VITE_RATE_LIMIT_WINDOW_MS=60000
VITE_MAX_PROMPT_CHARS=2000
VITE_STREAMING_MAX_DURATION_MS=30000

# Serverless Netlify Form Integration
NETLIFY_SITE_ID="flyrank-ai-capstone"
